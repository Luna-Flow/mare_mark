import {
  "moonbitlang/core/bench",
  "moonbitlang/core/debug",
  "moonbitlang/async",
  "moonbitlang/async/process",
  "Luna-Flow/mare_mark/model",
  "Luna-Flow/mare_mark/fixture",
  "Luna-Flow/mare_mark/event",
  "Luna-Flow/mare_mark/experiment",
}

import {
  "moonbitlang/core/json",
  "moonbitlang/core/test",
} for "wbtest"

// Native-only files (see `targets`) use some imports, so they are unused on other targets.

warnings = "-unused_package"

options(
  targets: {
    "worker_native.mbt": [ "native" ],
    "worker_unimplemented.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
