import {
  "Luna-Flow/mare_mark/ir_model" @ir,
  "Luna-Flow/mare_mark/model",
  "Luna-Flow/mare_mark/report",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/core/debug",
  "moonbitlang/core/bench",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
  "moonbitlang/async/stdio",
}

pkgtype(kind: "executable")

// Native-only files (see `targets`) use some imports, so they are unused on other targets.

warnings = "-unused_package"

options(
  targets: {
    "main.mbt": [ "native" ],
    "main_unimplemented.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
    "replay_native.mbt": [ "native" ],
  },
)
