msgid "Field"
msgstr ""

#: manual/api/env_detect.md:53
#: manual/index.md:58
msgid "Part"
msgstr ""

#: manual/api/env_detect.md:53
msgid "Value when not overridden"
msgstr ""

#: manual/api/env_detect.md:55
#: manual/api/env_detect.md:56
#: manual/api/env_detect.md:57
#: manual/api/env_detect.md:58
msgid "semantic"
msgstr ""

#: manual/api/env_detect.md:55
msgid "the target the code was compiled for (`Native`, `Js`, `Wasm`, `WasmGc` or `Llvm`)"
msgstr ""

#: manual/api/env_detect.md:56
msgid "the `MARE_MARK_TOOLCHAIN` environment variable, else `UNKNOWN`"
msgstr ""

#: manual/api/env_detect.md:57
#: manual/api/env_detect.md:58
