msgstr "本教程直接以 Plot IR 构建报告文档，这样你就可以发布并非来自 JSONL 流的结果，例如调优扫描或用 `stats` 计算的摘要。"

#: manual/tutorial/ir_model.md:9
msgid "build a report document by hand"
msgstr "手动构建报告文档"

#: manual/tutorial/ir_model.md:10
msgid "plot one value per scale and series"
msgstr "按规模和系列各绘制一个值"

#: manual/tutorial/ir_model.md:10
msgid "`@ir_model.Plot::new` with `PlotPoint::new`"
msgstr "带 `PlotPoint::new` 的 `@ir_model.Plot::new`"

#: manual/tutorial/ir_model.md:11
msgid "choose how a plot is drawn"
msgstr "选择图表的绘制方式"

#: manual/tutorial/ir_model.md:12
msgid "attach mismatches and counterexamples"
msgstr "附上不匹配项和反例"

#: manual/tutorial/ir_model.md:13
